# ---------------------------------------------------------------------------
# LinkLibrarian environment
# Copy this file to ".env" and fill in your key:   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED for AI summaries, tags, and categories.
# Get a free key at https://console.groq.com/keys  (no credit card needed).
GROQ_API_KEY=paste_your_groq_key_here

# --- AI settings (defaults are fine) ---
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_TIMEOUT=45

# --- Flask ---
SECRET_KEY=change-this-to-a-long-random-string
APP_ENV=development
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# --- Database ---
DATABASE_URL=sqlite:///linklibrarian.db

# --- Scraper ---
SCRAPER_TIMEOUT=15
SCRAPER_MAX_CHARS=12000
